---
interface Props {
	title: string;
	entryId: string;
}

const { title, entryId } = Astro.props;

const localeSegments = new Set(['en', 'zh-tw', 'fr', 'ja', 'ko']);
const rawSegments = entryId.split('/').filter(Boolean);
const segments = localeSegments.has(rawSegments[0] ?? '') ? rawSegments.slice(1) : rawSegments;

const moduleKey = segments[0] ?? 'guide';
const topicKey = segments[1] ?? 'overview';

const moduleMap: Record<
	string,
	{ label: string; accent: string; secondary: string; glyph: string; orbit: string[] }
> = {
	guide: {
		label: 'Guide',
		accent: '#f97316',
		secondary: '#fed7aa',
		glyph: '01',
		orbit: ['路径', '权限', '验证'],
	},
	prompts: {
		label: 'Prompts',
		accent: '#0ea5e9',
		secondary: '#bae6fd',
		glyph: '02',
		orbit: ['目标', '约束', '完成'],
	},
	skills: {
		label: 'Skills',
		accent: '#14b8a6',
		secondary: '#99f6e4',
		glyph: '03',
		orbit: ['流程', '扩展', '复用'],
	},
	cases: {
		label: 'Cases',
		accent: '#f43f5e',
		secondary: '#fecdd3',
		glyph: '04',
		orbit: ['任务', '执行', '复盘'],
	},
};

const moduleVisual =
	moduleMap[moduleKey] ??
	({
		label: 'Docs',
		accent: '#8b5cf6',
		secondary: '#ddd6fe',
		glyph: '05',
		orbit: ['内容', '结构', '协作'],
	} satisfies (typeof moduleMap)['guide']);

const topicSeed = `${moduleKey}/${topicKey}/${title}`;
const codePoints = Array.from(topicSeed).map((char) => char.codePointAt(0) ?? 0);
const hash = codePoints.reduce((sum, value, index) => (sum + value * (index + 17)) % 9973, 211);

const bars = Array.from({ length: 5 }, (_, index) => {
	const width = 28 + ((hash + index * 19) % 46);
	const offset = 20 + index * 14;
	return { width, offset };
});

const nodes = Array.from({ length: 4 }, (_, index) => {
	const x = 36 + ((hash + index * 31) % 200);
	const y = 40 + ((hash + index * 23) % 92);
	const radius = 7 + ((hash + index * 13) % 7);
	return { x, y, radius };
});

const hintMap: Record<
	string,
	{ variant: 'split' | 'terminal' | 'shield' | 'flow' | 'document'; chips: string[]; kicker: string }
> = {
	'local-vs-cloud': {
		variant: 'split',
		chips: ['本地', '云端', '切换场景'],
		kicker: '选择运行位置',
	},
	'files-tools-and-commands': {
		variant: 'terminal',
		chips: ['文件', '工具', '命令'],
		kicker: '让动作有边界',
	},
	'permissions-and-approvals': {
		variant: 'shield',
		chips: ['审批', '范围', '确认'],
		kicker: '关键动作先确认',
	},
	'sandbox-and-network': {
		variant: 'shield',
		chips: ['沙箱', '网络', '风险边界'],
		kicker: '先收口再放行',
	},
	'run-your-first-task': {
		variant: 'flow',
		chips: ['目标', '约束', '验收'],
		kicker: '第一次先做小任务',
	},
	'review-the-result': {
		variant: 'document',
		chips: ['差异', '验收', '修正'],
		kicker: '别只看“已完成”',
	},
	'undo-and-recover': {
		variant: 'flow',
		chips: ['撤销', '回退', '重试'],
		kicker: '先回到安全状态',
	},
	'context-and-files': {
		variant: 'document',
		chips: ['上下文', '文件', '聚焦'],
		kicker: '把相关信息交到手边',
	},
};

const pageHint = hintMap[topicKey] ?? {
	variant: 'document',
	chips: moduleVisual.orbit,
	kicker: `${moduleVisual.label} / ${topicKey.replace(/-/g, ' ')}`,
};
---

<figure class="doc-illustration" aria-label={`${title} 主题插图`}>
	<div class="doc-illustration__meta">
		<span class="doc-illustration__eyebrow">{moduleVisual.label}</span>
		<strong>{title}</strong>
		<p>{pageHint.kicker}</p>
		<div class="doc-illustration__chips">
			{pageHint.chips.map((chip) => <span>{chip}</span>)}
		</div>
	</div>
	<svg viewBox="0 0 320 180" role="img" aria-hidden="true">
		<defs>
			<linearGradient id={`panel-${hash}`} x1="0%" y1="0%" x2="100%" y2="100%">
				<stop offset="0%" stop-color={moduleVisual.secondary} stop-opacity="0.85" />
				<stop offset="100%" stop-color={moduleVisual.accent} stop-opacity="0.15" />
			</linearGradient>
			<linearGradient id={`stroke-${hash}`} x1="0%" y1="0%" x2="100%" y2="0%">
				<stop offset="0%" stop-color={moduleVisual.accent} stop-opacity="0.9" />
				<stop offset="100%" stop-color="#ffffff" stop-opacity="0.45" />
			</linearGradient>
		</defs>

		<rect x="10" y="10" width="300" height="160" rx="28" fill={`url(#panel-${hash})`} />
		{
			pageHint.variant === 'split' && (
				<>
					<rect x="24" y="24" width="118" height="128" rx="28" fill="#0f172a" fill-opacity="0.94" />
					<rect x="178" y="24" width="118" height="128" rx="28" fill="#0f172a" fill-opacity="0.94" />
					<rect x="126" y="46" width="68" height="78" rx="24" fill="#fff7ed" fill-opacity="0.98" stroke={moduleVisual.accent} stroke-width="2" />
					<text x="83" y="45" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700">
						Local
					</text>
					<text x="83" y="59" text-anchor="middle" fill="#94a3b8" font-size="8" font-weight="600">
						你的电脑
					</text>
					<text x="237" y="45" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700">
						Cloud
					</text>
					<text x="237" y="59" text-anchor="middle" fill="#94a3b8" font-size="8" font-weight="600">
						远程运行器
					</text>
					<text x="160" y="67" text-anchor="middle" fill={moduleVisual.accent} font-size="9" font-weight="700">
						怎么选
					</text>
					<text x="160" y="80" text-anchor="middle" fill="#475569" font-size="7" font-weight="700">
						看任务场景
					</text>
					<path d="M118 86 h8" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<path d="M194 86 h8" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<path d="M118 86 l-5 -4" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<path d="M118 86 l-5 4" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<path d="M202 86 l5 -4" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<path d="M202 86 l5 4" stroke={moduleVisual.accent} stroke-width="3.5" stroke-linecap="round" />
					<rect x="42" y="73" width="82" height="48" rx="12" fill="#e2e8f0" fill-opacity="0.98" />
					<rect x="48" y="79" width="70" height="29" rx="7" fill="#111827" />
					<path d="M56 93 l6 4 -6 4" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M68 97 h18" stroke="#e2e8f0" stroke-width="2" stroke-linecap="round" />
					<path d="M92 97 h11" stroke={moduleVisual.accent} stroke-width="2" stroke-linecap="round" />
					<path d="M60 124 h46" stroke="#94a3b8" stroke-width="4" stroke-linecap="round" />
					<path d="M56 131 h54" stroke="#475569" stroke-width="4" stroke-linecap="round" />
					<text x="83" y="144" text-anchor="middle" fill="#cbd5e1" font-size="8" font-weight="600">
						快改快看
					</text>
					<path d="M198 74 h78" stroke="#38bdf8" stroke-width="10" stroke-linecap="round" stroke-opacity="0.95" />
					<circle cx="214" cy="74" r="4" fill="#0f172a" />
					<circle cx="228" cy="74" r="4" fill="#0f172a" fill-opacity="0.72" />
					<circle cx="242" cy="74" r="4" fill="#0f172a" fill-opacity="0.45" />
					<rect x="197" y="90" width="82" height="16" rx="8" fill="#ffffff" fill-opacity="0.14" stroke={moduleVisual.accent} stroke-width="1.5" />
					<rect x="197" y="112" width="82" height="16" rx="8" fill="#ffffff" fill-opacity="0.1" />
					<rect x="197" y="134" width="52" height="10" rx="5" fill={moduleVisual.accent} fill-opacity="0.9" />
					<text x="238" y="101" text-anchor="middle" fill="#f8fafc" font-size="8" font-weight="700">
						GitHub / Queue
					</text>
					<text x="238" y="123" text-anchor="middle" fill="#cbd5e1" font-size="8" font-weight="600">
						长任务继续跑
					</text>
					<circle cx="145" cy="101" r="4" fill={moduleVisual.accent} fill-opacity="0.9" />
					<circle cx="160" cy="101" r="4" fill="#f59e0b" fill-opacity="0.9" />
					<circle cx="175" cy="101" r="4" fill="#38bdf8" fill-opacity="0.9" />
					<text x="160" y="113" text-anchor="middle" fill="#475569" font-size="7" font-weight="700">
						本机文件 / 长任务 / 远程仓库
					</text>
				</>
			)
		}
		{
			pageHint.variant === 'terminal' && (
				<>
					<rect x="32" y="34" width="256" height="112" rx="18" fill="#0f172a" fill-opacity="0.9" />
					<circle cx="56" cy="54" r="5" fill="#fb7185" />
					<circle cx="74" cy="54" r="5" fill="#f59e0b" />
					<circle cx="92" cy="54" r="5" fill="#22c55e" />
					<path d="M58 88 l14 12 -14 12" fill="none" stroke={moduleVisual.accent} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M84 112 h34" stroke="#cbd5e1" stroke-width="4" stroke-linecap="round" />
					{bars.map((bar, index) => (
						<rect
							x={144}
							y={72 + index * 14}
							width={bar.width + 20}
							height="8"
							rx="4"
							fill="#ffffff"
							fill-opacity={0.8 - index * 0.1}
						/>
					))}
				</>
			)
		}
		{
			pageHint.variant === 'shield' && (
				<>
					<path
						d="M160 38 l62 22 v34 c0 30 -20 52 -62 70 c-42 -18 -62 -40 -62 -70 V60 Z"
						fill="#0f172a"
						fill-opacity="0.9"
						stroke={`url(#stroke-${hash})`}
						stroke-width="3"
					/>
					<path
						d="M160 70 c14 0 24 10 24 24 s-10 24 -24 24 s-24 -10 -24 -24 s10 -24 24 -24 Z"
						fill={moduleVisual.accent}
						fill-opacity="0.18"
					/>
					<path d="M148 95 l10 10 18 -20" fill="none" stroke={moduleVisual.accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
					{nodes.map((node) => (
						<circle cx={node.x} cy={node.y} r={Math.max(4, node.radius - 3)} fill={moduleVisual.accent} fill-opacity="0.35" />
					))}
				</>
			)
		}
		{
			pageHint.variant === 'flow' && (
				<>
					<rect x="34" y="48" width="74" height="40" rx="16" fill="#0f172a" fill-opacity="0.9" />
					<rect x="123" y="48" width="74" height="40" rx="16" fill="#0f172a" fill-opacity="0.9" />
					<rect x="212" y="48" width="74" height="40" rx="16" fill="#0f172a" fill-opacity="0.9" />
					<text x="71" y="73" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700">Plan</text>
					<text x="160" y="73" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700">Do</text>
					<text x="249" y="73" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700">Check</text>
					<path d="M108 68 H123" stroke={moduleVisual.accent} stroke-width="4" stroke-linecap="round" />
					<path d="M197 68 H212" stroke={moduleVisual.accent} stroke-width="4" stroke-linecap="round" />
					<circle cx="160" cy="124" r="30" fill="#0f172a" fill-opacity="0.9" />
					<path d="M146 124 l10 10 18 -22" fill="none" stroke={moduleVisual.accent} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
				</>
			)
		}
		{
			pageHint.variant === 'document' && (
				<>
					<rect x="42" y="28" width="120" height="124" rx="18" fill="#0f172a" fill-opacity="0.9" />
					<rect x="178" y="46" width="96" height="88" rx="18" fill="#ffffff" fill-opacity="0.12" stroke={`url(#stroke-${hash})`} stroke-width="2" />
					<rect x="60" y="52" width="54" height="18" rx="9" fill={moduleVisual.accent} fill-opacity="0.92" />
					{bars.map((bar, index) => (
						<rect
							x={60}
							y={84 + index * 14}
							width={Math.min(82, bar.width)}
							height="7"
							rx="3.5"
							fill="#ffffff"
							fill-opacity={0.82 - index * 0.1}
						/>
					))}
					<path d="M194 74 h48" stroke="#ffffff" stroke-width="8" stroke-linecap="round" stroke-opacity="0.8" />
					<path d="M194 98 h62" stroke={moduleVisual.accent} stroke-width="8" stroke-linecap="round" stroke-opacity="0.92" />
					<path d="M194 122 h38" stroke="#ffffff" stroke-width="8" stroke-linecap="round" stroke-opacity="0.55" />
				</>
			)
		}
	</svg>
</figure>

<style>
	.doc-illustration {
		--doc-illustration-accent: {moduleVisual.accent};
		--doc-illustration-secondary: {moduleVisual.secondary};
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		margin: 1.4rem 0 0.4rem;
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--doc-illustration-accent) 24%, var(--sl-color-hairline));
		border-radius: 1.25rem;
		background:
			radial-gradient(circle at top left, color-mix(in srgb, var(--doc-illustration-secondary) 28%, transparent), transparent 48%),
			linear-gradient(
				140deg,
				color-mix(in srgb, var(--sl-color-bg-nav) 82%, transparent),
				color-mix(in srgb, var(--sl-color-black) 14%, var(--sl-color-bg))
			);
		box-shadow: 0 18px 40px color-mix(in srgb, var(--sl-color-black) 18%, transparent);
		overflow: hidden;
	}

	.doc-illustration__meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.doc-illustration__meta strong {
		font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--sl-color-white);
	}

	.doc-illustration__eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--doc-illustration-accent);
	}

	.doc-illustration__meta p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--sl-color-gray-2);
	}

	.doc-illustration__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.doc-illustration__chips span {
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--doc-illustration-accent) 28%, transparent);
		background: color-mix(in srgb, var(--doc-illustration-accent) 14%, transparent);
		font-size: 0.8rem;
		color: var(--sl-color-gray-1);
	}

	.doc-illustration svg {
		width: 100%;
		height: auto;
		display: block;
	}

	@media (min-width: 46rem) {
		.doc-illustration {
			grid-template-columns: minmax(10rem, 0.9fr) minmax(0, 1.8fr);
			align-items: center;
			padding: 1.2rem 1.3rem;
		}
	}
 </style>
