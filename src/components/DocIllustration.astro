const moduleMap =
	uiLang === 'zh'
		? moduleMapZh
		: uiLang === 'ja'
			? moduleMapJa
			: uiLang === 'fr'
				? moduleMapFr
				: uiLang === 'ko'
					? moduleMapKo
					: uiLang === 'es'
						? moduleMapEs
						: uiLang === 'de'
							? moduleMapDe
							: uiLang === 'pt'
								? moduleMapPt
								: uiLang === 'vi'
									? moduleMapVi
									: moduleMapEn;

const moduleVisual =
	moduleMap[moduleKey] ??
	({
		label: 'Docs',
		accent: '#8b5cf6',
		secondary: '#ddd6fe',
		glyph: '05',
		orbit:
			uiLang === 'zh'
				? ['内容', '结构', '协作']
				: uiLang === 'ja'
					? ['内容', '構造', '協業']
					: uiLang === 'fr'
						? ['Contenu', 'Structure', 'Collab']
						: uiLang === 'ko'
							? ['내용', '구조', '협업']
							: uiLang === 'es'
								? ['Contenido', 'Estructura', 'Colab']
								: uiLang === 'de'
									? ['Inhalt', 'Struktur', 'Kollab']
									: uiLang === 'pt'
										? ['Conteúdo', 'Estrutura', 'Colab']
										: uiLang === 'vi'
											? ['Nội dung', 'Cấu trúc', 'Cộng tác']
											: ['Content', 'Structure', 'Collab'],
	} satisfies ModuleVisual);

const topicSeed = `${moduleKey}/${topicKey}/${title}`;
const codePoints = Array.from(topicSeed).map((char) => char.codePointAt(0) ?? 0);
const hash = codePoints.reduce((sum, value, index) => (sum + value * (index + 17)) % 9973, 211);

const bars = Array.from({ length: 5 }, (_, index) => {
	const width = 28 + ((hash + index * 19) % 46);
	const offset = 20 + index * 14;
	return { width, offset };
});

const nodes = Array.from({ length: 4 }, (_, index) => {
	const x = 36 + ((hash + index * 31) % 200);
	const y = 40 + ((hash + index * 23) % 92);
	const radius = 7 + ((hash + index * 13) % 7);
	return { x, y, radius };
});

