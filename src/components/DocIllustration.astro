---
interface Props {
	title: string;
	entryId: string;
}

const { title, entryId } = Astro.props;

import { CONTENT_LOCALE_PREFIXES } from '../utils/siteLocales';

const localeSegments = CONTENT_LOCALE_PREFIXES;
const rawSegments = entryId.split('/').filter(Boolean);
const segments = localeSegments.has(rawSegments[0] ?? '') ? rawSegments.slice(1) : rawSegments;

const routeLocale = Astro.locals.starlightRoute?.locale ?? 'root';
const uiLang: 'zh' | 'ja' | 'fr' | 'ko' | 'es' | 'de' | 'pt' | 'vi' | 'en' =
	routeLocale === 'root' || routeLocale === 'zh-tw'
		? 'zh'
		: routeLocale === 'ja'
			? 'ja'
			: routeLocale === 'fr'
				? 'fr'
				: routeLocale === 'ko'
					? 'ko'
					: routeLocale === 'es'
						? 'es'
						: routeLocale === 'de'
							? 'de'
							: routeLocale === 'pt'
								? 'pt'
								: routeLocale === 'vi'
									? 'vi'
									: 'en';

const moduleKey = segments[0] ?? 'guide';
const topicKey = segments[1] ?? 'overview';

