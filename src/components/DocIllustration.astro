<style>
	.doc-illustration {
		--doc-illustration-accent: {moduleVisual.accent};
		--doc-illustration-secondary: {moduleVisual.secondary};
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		margin: 1.4rem 0 0.4rem;
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--doc-illustration-accent) 24%, var(--sl-color-hairline));
		border-radius: 1.25rem;
		background:
			radial-gradient(circle at top left, color-mix(in srgb, var(--doc-illustration-secondary) 28%, transparent), transparent 48%),
			linear-gradient(
				140deg,
				color-mix(in srgb, var(--sl-color-bg-nav) 82%, transparent),
				color-mix(in srgb, var(--sl-color-black) 14%, var(--sl-color-bg))
			);
		box-shadow: 0 18px 40px color-mix(in srgb, var(--sl-color-black) 18%, transparent);
		overflow: hidden;
	}

	.doc-illustration__meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.doc-illustration__meta strong {
		font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
		line-height: 1;
		letter-spacing: -0.05em;
		color: var(--sl-color-white);
	}

	.doc-illustration__eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--doc-illustration-accent);
	}

	.doc-illustration__meta p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--sl-color-gray-2);
	}

	.doc-illustration__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.doc-illustration__chips span {
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--doc-illustration-accent) 28%, transparent);
		background: color-mix(in srgb, var(--doc-illustration-accent) 14%, transparent);
		font-size: 0.8rem;
		color: var(--sl-color-gray-1);
	}

	.doc-illustration svg {
		width: 100%;
		height: auto;
		display: block;
	}

	@media (min-width: 46rem) {
		.doc-illustration {
			grid-template-columns: minmax(10rem, 0.9fr) minmax(0, 1.8fr);
			align-items: center;
			padding: 1.2rem 1.3rem;
		}
	}
 </style>
