---
import config from 'virtual:starlight/user-config';
import context from 'virtual:starlight/project-context';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import { getActiveModule } from '../utils/activeModule';
import { localizedUrl } from '../utils/localizedUrl';
import { getSiteLang, isNavItemVisible, mainNavItems, pickLabel, uiLabels } from '../utils/siteNav';
import { standaloneHref, type StandalonePageId } from '../utils/standalonePages';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const locale = Astro.locals.starlightRoute.locale ?? 'root';
const normalizedLocale = locale === 'root' ? undefined : locale;
const lang = getSiteLang(locale, config.locales?.[locale]?.lang);
const hasSidebar = Astro.locals.starlightRoute.hasSidebar;
const visibleMainNavItems = mainNavItems.filter((item) => isNavItemVisible(item, lang));
const primaryNavItems = visibleMainNavItems.filter((item) => item.href !== '/pets/' && item.href !== '/theme/');
const secondaryNavItems = visibleMainNavItems.filter((item) => item.href === '/pets/' || item.href === '/theme/');

function localizeHref(item: { href: string; global?: boolean; standalonePage?: StandalonePageId }) {
	if (item.global) return item.href;
	if (item.standalonePage) return standaloneHref(item.standalonePage, locale);
	return localizedUrl(new URL(item.href, Astro.url), locale, context.trailingSlash).pathname;
}

function isActive(prefix: string) {
	const moduleDir = prefix.replace(/^\//, '');
	return getActiveModule(Astro.url.pathname, normalizedLocale) === moduleDir;
}

const isMoreActive = secondaryNavItems.some((item) => isActive(item.prefix));
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="main-nav sl-hidden md:sl-flex print:hidden" aria-label={pickLabel(uiLabels.mainNav, lang)}>
		{
			primaryNavItems.map((item) => (
				<a
					href={localizeHref(item)}
					aria-current={isActive(item.prefix) ? 'page' : undefined}
				>
					{pickLabel(item.label, lang)}
				</a>
			))
		}
		{
			secondaryNavItems.length > 0 && (
				<details class:list={{ 'more-menu': true, 'is-active': isMoreActive }}>
					<summary>
						<span>{pickLabel(uiLabels.more, lang)}</span>
						<Icon name="down-caret" aria-hidden="true" />
					</summary>
					<div class="more-menu__panel">
						{secondaryNavItems.map((item) => (
							<a
								href={localizeHref(item)}
								aria-current={isActive(item.prefix) ? 'page' : undefined}
							>
								{pickLabel(item.label, lang)}
							</a>
						))}
					</div>
				</details>
			)
		}
	</nav>
	<div class="sl-flex print:hidden header-search">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-flex print:hidden header-controls">
		<div class="sl-hidden md:sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
		{
			!hasSidebar && (
				<details class="mobile-nav md:sl-hidden">
					<summary>
						<span class="sr-only">{pickLabel(uiLabels.menu, lang)}</span>
						<Icon name="bars" aria-hidden="true" />
					</summary>
					<nav class="mobile-nav__panel" aria-label={pickLabel(uiLabels.mainNav, lang)}>
						{visibleMainNavItems.map((item) => (
							<a
								href={localizeHref(item)}
								aria-current={isActive(item.prefix) ? 'page' : undefined}
							>
								{pickLabel(item.label, lang)}
							</a>
						))}
					</nav>
				</details>
			)
		}
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: visible;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.main-nav {
			gap: 0.25rem;
			align-items: center;
		}

		.main-nav a {
			padding: 0.35rem 0.65rem;
			border-radius: 0.375rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
			transition:
				color 0.15s ease,
				background-color 0.15s ease;
		}

		.main-nav a:hover {
			color: var(--sl-color-white);
			background-color: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
		}

		.main-nav a[aria-current='page'] {
			color: var(--sl-color-accent-high);
			background-color: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		}

		.more-menu {
			position: relative;
		}

		.more-menu summary {
			display: inline-flex;
			align-items: center;
			gap: 0.2rem;
			padding: 0.35rem 0.65rem;
			border-radius: 0.375rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			cursor: pointer;
			list-style: none;
			white-space: nowrap;
		}

		.more-menu summary::-webkit-details-marker {
			display: none;
		}

		.more-menu summary svg {
			width: 0.9em;
			height: 0.9em;
			transition: transform 0.15s ease;
		}

		.more-menu[open] summary svg {
			transform: rotate(180deg);
		}

		.more-menu summary:hover,
		.more-menu.is-active summary,
		.more-menu[open] summary {
			color: var(--sl-color-accent-high);
			background-color: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		}

		.more-menu__panel {
			position: absolute;
			z-index: 20;
			top: calc(100% + 0.4rem);
			inset-inline-end: 0;
			display: grid;
			min-width: 9rem;
			padding: 0.35rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.55rem;
			background: var(--sl-color-bg-nav);
			box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--sl-color-black) 18%, transparent);
		}

		.more-menu__panel a {
			padding: 0.5rem 0.6rem;
			border-radius: 0.35rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			text-decoration: none;
			white-space: nowrap;
		}

		.more-menu__panel a:hover,
		.more-menu__panel a[aria-current='page'] {
			color: var(--sl-color-accent-high);
			background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		}

		.mobile-nav {
			position: relative;
		}

		.mobile-nav summary {
			display: grid;
			place-items: center;
			width: 2.375rem;
			height: 2.375rem;
			border-radius: 0.5rem;
			color: var(--sl-color-gray-2);
			cursor: pointer;
			list-style: none;
		}

		.mobile-nav summary::-webkit-details-marker {
			display: none;
		}

		.mobile-nav summary:hover,
		.mobile-nav[open] summary {
			color: var(--sl-color-accent-high);
			background-color: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		}

		.mobile-nav summary svg {
			width: 1.1rem;
			height: 1.1rem;
		}

		.mobile-nav__panel {
			position: absolute;
			z-index: 40;
			top: calc(100% + 0.45rem);
			inset-inline-end: 0;
			display: grid;
			min-width: 12.5rem;
			max-width: min(18rem, calc(100vw - 1.5rem));
			padding: 0.4rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.6rem;
			background: var(--sl-color-bg-nav);
			box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--sl-color-black) 18%, transparent);
		}

		.mobile-nav__panel a {
			padding: 0.55rem 0.7rem;
			border-radius: 0.4rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			text-decoration: none;
			white-space: nowrap;
		}

		.mobile-nav__panel a:hover,
		.mobile-nav__panel a[aria-current='page'] {
			color: var(--sl-color-accent-high);
			background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
		}

		.header-search {
			width: clamp(10rem, 15vw, 13rem);
			min-width: 0;
		}

		.header-search :global(site-search) {
			display: block;
			width: 100%;
		}

		.header-search :global(site-search > button) {
			width: 100%;
		}

		.right-group,
		.header-controls,
		.social-icons {
			gap: 0.65rem;
			align-items: center;
		}

		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			.header {
				--header-search-width: clamp(10rem, 15vw, 13rem);
			}

			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto var(--header-search-width) auto;
				align-content: center;
			}
		}

		@media (min-width: 72rem) {
			.header {
				position: relative;
				grid-template-columns: minmax(0, 1fr) var(--header-search-width) auto;
			}

			.main-nav {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
			}

			.header-search {
				grid-column: 2;
			}

			.header-controls {
				grid-column: 3;
			}
		}
	}
</style>
