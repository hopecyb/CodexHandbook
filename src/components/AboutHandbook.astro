---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<article class="about-handbook sl-flex" aria-labelledby="about-handbook-heading">
	<small id="about-handbook-heading">{title}</small>
	<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="currentColor">
		<path
			fill-rule="evenodd"
			d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z"
			clip-rule="evenodd"></path>
	</svg>
	<slot />
</article>

<style>
	.about-handbook {
		max-width: 40rem;
		margin-inline: auto;
		padding-block: 5rem;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
	}

	.about-handbook > :global(*) {
		max-width: 50ch;
		margin-top: 0 !important;
	}

	small {
		color: var(--sl-color-gray-3);
	}

	svg {
		width: 5rem;
		color: var(--sl-color-white);
	}
</style>
