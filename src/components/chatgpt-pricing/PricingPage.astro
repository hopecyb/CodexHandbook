---
import { currentYear, languages, translations } from '../../data/chatgptPricing';
import '../../styles/chatgpt-pricing.css';
import quotes from '../../data/chatgptPriceQuotes.json';
import planQuotes from '../../data/chatgptPlanQuotes.json';
import planCopy from '../../data/chatgptPlanCopy.json';
import snapshotCopy from '../../data/chatgptSnapshotCopy.json';
import Analytics from '../Analytics.astro';
import PricingFooter from './PricingFooter.astro';
import {
	standaloneHref,
	standaloneHrefForLang,
	standaloneLocaleFromLang,
	type StandaloneLocaleCode,
} from '../../utils/standalonePages';
import { readerNavItems, pickLabel, type SiteLang } from '../../utils/siteNav';

interface Props {
	initialLanguage: SiteLang;
}

const { initialLanguage } = Astro.props;
const t = (key: string) => translations[initialLanguage]?.[key] ?? translations['zh-CN'][key] ?? key;
const currentLocale = standaloneLocaleFromLang(initialLanguage);
const languageRoutes = Object.fromEntries(
	languages.map((language) => [language.code, standaloneHrefForLang('chatgpt-pricing', language.code as SiteLang)]),
);
const currentPath = standaloneHref('chatgpt-pricing', currentLocale);
const canonicalUrl = `https://codexhandbook.com${currentPath}`;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: planCopy[initialLanguage].title,
	description: planCopy[initialLanguage].subtitle,
	url: canonicalUrl,
	inLanguage: initialLanguage,
	isPartOf: {
		'@type': 'WebSite',
		name: 'Codex Handbook',
		url: 'https://codexhandbook.com/',
	},
};

function localizedPath(path: string, locale: StandaloneLocaleCode = currentLocale) {
	if (locale === 'root') return path;
	return `/${locale}${path}`;
}

const chinese = initialLanguage === 'zh-CN' || initialLanguage === 'zh-TW';
const topbarLinks: {href: string; key?: string; label?: string; current?: boolean}[] = chinese ? [
  ...readerNavItems(initialLanguage).slice(0,3).map(item => ({href: localizedPath(item.href), label: pickLabel(item.label, initialLanguage)})),
  {href: currentPath, key: 'pricingNav', current: true},
] : [
	{ href: localizedPath('/guide/'), key: 'guide' },
	{ href: localizedPath('/prompts/'), key: 'prompts' },
	{ href: localizedPath('/skills/'), key: 'skills' },
	{ href: localizedPath('/cases/'), key: 'cases' },
	{ href: currentPath, key: 'pricingNav', current: true },
	{ href: localizedPath('/pets/'), key: 'pets' },
	{ href: localizedPath('/theme/'), key: 'theme' },
];
const plan = planCopy[initialLanguage];
const copy = snapshotCopy[initialLanguage];
const guideHref = localizedPath('/guide/reference/model-selection/');
const planCheckedAt = planQuotes.reduce(
	(latest, quote) => quote.checkedAt > latest ? quote.checkedAt : latest,
	'0000-00-00',
);
const officialNote = plan.officialNote.replace(/\d{4}-\d{2}-\d{2}/, planCheckedAt);

function formatPlanPrice(quote: (typeof planQuotes)[number]) {
	if (quote.period !== 'user-month' || !('billing' in quote)) {
		return `${quote.currency} ${quote.amount} / ${plan.month}`;
	}
	if (initialLanguage === 'zh-CN') {
		return `${quote.currency} ${quote.amount} / 用户 / 月（${quote.billing === 'annual' ? '年付' : '月付'}，至少 2 人）`;
	}
	if (initialLanguage === 'zh-TW') {
		return `${quote.currency} ${quote.amount} / 使用者 / 月（${quote.billing === 'annual' ? '年付' : '月付'}，至少 2 人）`;
	}
	return `${quote.currency} ${quote.amount} / user / ${plan.month} · ${quote.billing} billing · minimum 2 users`;
}

---

<!doctype html>
<html lang={initialLanguage}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.clarity.ms https://c.bing.com; img-src 'self' data: blob: https://www.google-analytics.com https://*.clarity.ms https://c.bing.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:" />
		<title>{plan.title} | Codex Handbook</title>
		<meta name="description" content={plan.subtitle} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Codex Handbook" />
		<meta property="og:title" content={`${plan.title} | Codex Handbook`} />
		<meta property="og:description" content={plan.subtitle} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<link rel="canonical" href={canonicalUrl} />
		{
			languages.map((language) => (
				<link
					rel="alternate"
					hreflang={language.code}
					href={`https://codexhandbook.com${languageRoutes[language.code]}`}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href="https://codexhandbook.com/chatgpt-pricing/" />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<main class="pricing-shell">
			<nav class="topbar" aria-label={copy.pageNav}>
				<div class="topbar-primary">
					<a href={localizedPath('/')} class="brand">
						<img src="/brand/logo.png" alt="" width="32" height="32" />
						<span data-i18n="back">{t('back')}</span>
					</a>
					<details class="topbar-menu">
						<summary aria-label={copy.menu}>
							<span class="topbar-menu__icon" aria-hidden="true"></span>
						</summary>
						<div class="topbar-nav topbar-nav--panel" aria-label={copy.mainNav}>
							{
								topbarLinks.map((link) => (
									<a href={link.href} data-i18n={link.key} aria-current={link.current ? 'page' : undefined}>
										{link.label ?? t(link.key!)}
									</a>
								))
							}
						</div>
					</details>
				</div>
				<div class="topbar-nav topbar-nav--desktop" aria-label={copy.mainNav}>
					{
						topbarLinks.map((link) => (
							<a href={link.href} data-i18n={link.key} aria-current={link.current ? 'page' : undefined}>
								{link.label ?? t(link.key!)}
							</a>
						))
					}
				</div>
			</nav>

            <div lang={initialLanguage}>
            <section class="hero">
                <div>
                    <p class="eyebrow">{copy.sourceChecked} · {planCheckedAt}</p>
                    <h1>{plan.title}</h1>
                    <p>{plan.subtitle}</p>
                </div>
            </section>
            <nav class="snapshot-languages" aria-label={t('language')}>
                {languages.map(language => <a href={languageRoutes[language.code]} aria-current={language.code === initialLanguage ? 'page' : undefined}>{language.label}</a>)}
            </nav>
            <nav class="snapshot-languages section-links" aria-label={plan.navigation}>
                <a href="#plan-selection">{plan.plans}</a>
                <a href="#official-prices">{plan.official}</a>
                <a href="#channel-history">{plan.history}</a>
                <a href="#notes-heading">{plan.notes}</a>
            </nav>
            <p class="model-guide-link"><a href={guideHref}>{plan.guide}</a></p>
            <section class="plan-section" id="plan-selection" aria-labelledby="plan-heading">
                <h2 id="plan-heading">{plan.plans}</h2>
                <p>{plan.editorial}</p>
                <div class="snapshot-table plan-table" tabindex="0" role="region" aria-label={plan.plans}>
                    <table>
                        <caption>{plan.plans}</caption>
                        <thead><tr><th scope="col">{plan.plan}</th><th scope="col">{plan.fit}</th><th scope="col">{plan.upgrade}</th></tr></thead>
                        <tbody>{plan.rows.map(row => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
                    </table>
                </div>
                <p>{plan.limit}</p>
                <p><a href="https://chatgpt.com/pricing/">{plan.more} ↗</a></p>
            </section>
            <section class="plan-section" id="official-prices" aria-labelledby="official-heading">
                <h2 id="official-heading">{plan.official}</h2>
                <p>{officialNote}</p>
                <div class="snapshot-table" tabindex="0" role="region" aria-label={plan.official}>
                    <table>
                        <caption>USD · {plan.month} · {planCheckedAt}</caption>
                        <thead><tr><th scope="col">{plan.plan}</th><th scope="col">{plan.monthly}</th><th scope="col">{plan.coverage}</th><th scope="col">{plan.date}</th><th scope="col">{plan.source}</th></tr></thead>
                        <tbody>{planQuotes.map(quote => <tr><th scope="row">{quote.plan}</th><td>{formatPlanPrice(quote)}</td><td>{plan.unknown}</td><td><time datetime={quote.checkedAt}>{quote.checkedAt}</time></td><td><a href={quote.source}>{plan.source} ↗</a></td></tr>)}</tbody>
                    </table>
                </div>
            </section>
            <section class="plan-section" id="channel-history" aria-labelledby="history-heading">
                <h2 id="history-heading">{plan.history}</h2>
                <p>{plan.historyNote}</p>
            </section>
            <p class="snapshot-notice">{copy.scope}</p>
            <div class="snapshot-filter" hidden>
                <label for="quote-scope">{copy.filter}</label>
                <select id="quote-scope"><option value="US">{copy.us}</option><option value="other">{copy.other}</option></select>
            </div>
            <section id="verified-quotes" aria-labelledby="quotes-heading">
                <h2 id="quotes-heading">{copy.heading}</h2>
                <div class="snapshot-table" tabindex="0" role="region" aria-label={copy.heading}>
                    <table>
                        <caption>{copy.us} · USD · 2026-09-18</caption>
                        <thead><tr><th scope="col">{copy.item}</th><th scope="col">{copy.price}</th><th scope="col">{copy.region}</th><th scope="col">{copy.date}</th><th scope="col">{copy.source}</th></tr></thead>
                        <tbody>{quotes.map(quote => <tr><th scope="row">{quote.label}</th><td>{quote.currency} {quote.amount}</td><td>{copy.us}</td><td><time datetime={quote.checkedAt}>{quote.checkedAt}</time></td><td><a href={quote.source} target="_blank" rel="noopener noreferrer">App Store ↗</a></td></tr>)}</tbody>
                    </table>
                </div>
            </section>
            <section id="missing-quotes" hidden aria-live="polite"><h2>{copy.missing}</h2><p>{copy.noData}</p></section>
            <section class="snapshot-notes" aria-labelledby="notes-heading">
                <h2 id="notes-heading">{copy.notes}</h2>
                <p>{copy.historical}</p><p>{copy.unknown}</p><p>{copy.ambiguity}</p>
                <p><a href="https://apps.apple.com/us/app/chatgpt/id6448311069" target="_blank" rel="noopener noreferrer">{copy.source} · Apple App Store</a></p>
            </section>

            </div>
		</main>

		<PricingFooter year={currentYear} locale={currentLocale} lang={initialLanguage} />
		<Analytics />

		<script src="/scripts/chatgpt-pricing.js" defer></script>
	</body>
</html>

<style>
.plan-section { margin-block: 2.5rem 1rem; line-height: 1.8; scroll-margin-top: 1rem; }
.plan-table td { white-space: normal; min-width: 12rem; }
.plan-table th { white-space: nowrap; }
.model-guide-link { padding: 1.2rem; border: 1px solid var(--brand); border-radius: 12px; background: var(--brand-soft); line-height: 1.7; }
.model-guide-link a { color: var(--brand-deep); font-weight: 700; }
.section-links { padding-block: 1rem; border-block: 1px solid var(--line); }
a:focus-visible, .snapshot-table:focus-visible { outline: 3px solid var(--brand); outline-offset: 4px; }
.snapshot-languages { display:flex; flex-wrap:wrap; gap:.6rem 1rem; margin-block:1rem; }
.snapshot-languages a[aria-current="page"] { font-weight:700; text-decoration-thickness:3px; }
.snapshot-notice { padding:1rem; border-left:3px solid var(--brand); background:white; line-height:1.8; }
.snapshot-filter { margin:1.5rem 0; }
.snapshot-filter label { margin-inline-end:1rem; }
.snapshot-filter select { max-width:100%; padding:.5rem; }
.snapshot-table { overflow-x:auto; border:1px solid var(--line); border-radius:12px; background:white; }
table { width:100%; border-collapse:collapse; text-align:left; }
caption { text-align:left; padding:1rem; font-weight:600; }
th, td { padding:1rem; border-top:1px solid var(--line); white-space:nowrap; }
.snapshot-notes { line-height:1.8; max-width:60rem; margin-top:2rem; }
[hidden] { display:none !important; }
@media(max-width:600px) { th,td { padding:.75rem; } }
</style>
