---
import logo from '../assets/brand/logo.png';

const siteUrl = 'https://codexhandbook.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const entry = Astro.locals.starlightRoute.entry;
const locale = Astro.locals.starlightRoute.locale ?? 'root';
const languages: Record<string, string> = {
	root: 'zh-CN',
	'zh-tw': 'zh-TW',
	en: 'en',
	fr: 'fr',
	de: 'de',
	es: 'es',
	pt: 'pt',
	vi: 'vi',
	ja: 'ja',
	ko: 'ko',
	th: 'th',
	ru: 'ru',
};
const isHomePage = entry.data.template === 'splash';
const title = entry.data.title;
const description = entry.data.description;

const graph = [
	{
		'@type': 'Organization',
		'@id': `${siteUrl}/#organization`,
		name: 'Codex Handbook',
		url: siteUrl,
		logo: new URL(logo.src, siteUrl).href,
		sameAs: ['https://github.com/hopecyb/CodexHandbook'],
	},
	{
		'@type': 'WebSite',
		'@id': `${siteUrl}/#website`,
		name: 'Codex Handbook',
		alternateName: 'Codex 指南手册',
		url: siteUrl,
		inLanguage: Object.values(languages),
		publisher: { '@id': `${siteUrl}/#organization` },
	},
	{
		'@type': isHomePage ? 'CollectionPage' : 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: title,
		description,
		isPartOf: { '@id': `${siteUrl}/#website` },
		about: { '@id': `${siteUrl}/#organization` },
		author: {
			'@type': 'Organization',
			name: 'Codex Handbook contributors',
			url: 'https://github.com/hopecyb/CodexHandbook',
		},
		inLanguage: languages[locale] ?? 'zh-CN',
	},
];
---

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
