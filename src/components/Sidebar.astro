---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { getActiveModule } from '../utils/activeModule';
import { filterSidebarByModule, getSidebarHash } from '../utils/filterSidebar';
import { localizeSidebarLabels } from '../utils/localizeSidebar';
import ModuleSidebarPersister from './ModuleSidebarPersister.astro';

const { sidebar } = Astro.locals.starlightRoute;
const locale = Astro.locals.starlightRoute.locale;
const normalizedLocale = !locale || locale === 'root' ? undefined : locale;
const activeModule = getActiveModule(Astro.url.pathname, normalizedLocale);
const filteredSidebar = localizeSidebarLabels(
	filterSidebarByModule(sidebar, activeModule, normalizedLocale),
);
const hash = getSidebarHash(filteredSidebar);
---

<ModuleSidebarPersister hash={hash}>
	<SidebarSublist sublist={filteredSidebar} />
</ModuleSidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
