---
import config from 'virtual:starlight/user-config';
import context from 'virtual:starlight/project-context';
import logo from '../assets/brand/logo.png';
import { getActiveModule } from '../utils/activeModule';
import { localizedUrl } from '../utils/localizedUrl';
import {
	footerBrand,
	footerLegal,
	footerLinkGroups,
	getSiteLang,
	isNavItemVisible,
	mainNavItems,
	pickLabel,
	uiLabels,
} from '../utils/siteNav';

const locale = Astro.locals.starlightRoute.locale ?? 'root';
const normalizedLocale = locale === 'root' ? undefined : locale;
const lang = getSiteLang(locale, config.locales?.[locale]?.lang);
const year = new Date().getFullYear();

function localizeHref(path: string) {
	return localizedUrl(new URL(path, Astro.url), locale, context.trailingSlash).pathname;
}

function isModuleActive(href: string) {
	const item = mainNavItems.find((nav) => nav.href === href);
	if (!item) return false;
	const moduleDir = item.prefix.replace(/^\//, '');
	return getActiveModule(Astro.url.pathname, normalizedLocale) === moduleDir;
}

const footerLabel = pickLabel(uiLabels.siteFooter, lang);
const visibleFooterLinkGroups = footerLinkGroups.map((group) => ({
	...group,
	links: group.links.filter((link) => isNavItemVisible(link, lang)),
}));
---

<footer class="site-footer print:hidden" aria-label={footerLabel}>
	<div class="site-footer__inner">
		<div class="site-footer__grid">
			<div class="site-footer__brand">
				<a class="site-footer__brand-link" href={localizeHref('/')}>
					<img src={logo.src} alt="" width="36" height="36" loading="lazy" decoding="async" />
					<span>{pickLabel(footerBrand.name, lang)}</span>
				</a>
				<p class="site-footer__tagline">{pickLabel(footerBrand.tagline, lang)}</p>
			</div>

			{
				visibleFooterLinkGroups.map((group) => (
					<nav class="site-footer__group" aria-labelledby={`footer-${group.id}`}>
						<p class="site-footer__group-title" id={`footer-${group.id}`}>
							{pickLabel(group.title, lang)}
						</p>
						<ul>
							{group.links.map((link) => {
								const href = link.external || link.global ? link.href : localizeHref(link.href);
								const current =
									!link.external && group.id === 'modules' && isModuleActive(link.href)
										? 'page'
										: undefined;
								return (
									<li>
										<a
											href={href}
											aria-current={current}
											{...(link.external
												? { target: '_blank', rel: 'noopener noreferrer' }
												: {})}
										>
											{pickLabel(link.label, lang)}
										</a>
									</li>
								);
							})}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="site-footer__legal">
			<p>
				<span>&copy; {year}</span>
				{' '}
				<a href={localizeHref('/')}>{footerLegal.site}</a>
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: 100%;
		border-top: 1px solid var(--sl-color-gray-5);
		background-color: var(--sl-color-bg-nav);
	}

	.site-footer__inner {
		width: 100%;
		padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem) 1.5rem;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
	}

	.site-footer__brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin-block-end: 0.75rem;
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}

	.site-footer__brand-link img {
		border-radius: 0.35rem;
	}

	.site-footer__tagline {
		margin: 0;
		max-width: 22rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.7;
	}

	.site-footer__group-title {
		margin: 0 0 0.75rem;
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-sm);
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.site-footer__group ul {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__group a {
		display: inline-block;
		padding: 0.3rem 0.5rem;
		margin-inline-start: -0.5rem;
		border-radius: 0.375rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.site-footer__group a:hover {
		color: var(--sl-color-white);
		background-color: color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent);
	}

	.site-footer__group a[aria-current='page'] {
		color: var(--sl-color-accent-high);
		background-color: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
	}

	.site-footer__legal {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 0.75rem;
		padding-block-start: 1.25rem;
		border-top: 1px solid var(--sl-color-gray-6);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.site-footer__legal p {
		margin: 0;
	}

	.site-footer__legal a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.site-footer__legal a:hover {
		color: var(--sl-color-white);
	}

	:global(html[data-theme='light']) .site-footer__brand-link {
		color: var(--sl-color-gray-1);
	}

	:global(html[data-theme='light']) .site-footer__group a:hover,
	:global(html[data-theme='light']) .site-footer__legal a:hover {
		color: var(--sl-color-gray-1);
	}

	@media (max-width: 64rem) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}

		.site-footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 44rem) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
