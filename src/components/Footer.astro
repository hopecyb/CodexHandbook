---
import { feedbackUrl } from '../utils/contentFeedback.mjs';
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import AdSlot from './AdSlot.astro';

const { pagination, entry, toc } = Astro.locals.starlightRoute;
const locale = Astro.locals.starlightRoute.locale ?? 'root';
const showAd = entry.data.template !== 'splash';
const vietnamese = Astro.locals.starlightRoute.locale === 'vi';
const thai = Astro.locals.starlightRoute.locale === 'th';
const russian = Astro.locals.starlightRoute.locale === 'ru';
const portuguese = Astro.locals.starlightRoute.locale === 'pt';
const german = Astro.locals.starlightRoute.locale === 'de';
const french = Astro.locals.starlightRoute.locale === 'fr';
const korean = Astro.locals.starlightRoute.locale === 'ko';
const japanese = Astro.locals.starlightRoute.locale === 'ja';
const spanish = entry.id.startsWith('es/');
const english = entry.id.startsWith('en/');
const traditional = entry.id.startsWith('zh-tw/');
const chinese = !/^(en|de|es|fr|ja|ko|pt|vi|th|ru)\//.test(entry.id);
// The splash homepage already links updates and contributing in its about block.
const showFeedback = (chinese || english || spanish || japanese || korean || french || german || portuguese || vietnamese || thai || russian) && entry.data.template !== 'splash';
const correction = feedbackUrl({ pathname: Astro.url.pathname, title: entry.data.title, locale });
const updatesPath = russian ? '/ru/guide/updates/' : thai ? '/th/guide/updates/' : vietnamese ? '/vi/guide/updates/' : portuguese ? '/pt/guide/updates/' : german ? '/de/guide/updates/' : french ? '/fr/guide/updates/' : korean ? '/ko/guide/updates/' : japanese ? '/ja/guide/updates/' : spanish ? '/es/guide/updates/' : english ? '/en/guide/updates/' : traditional ? '/zh-tw/guide/updates/' : '/guide/updates/';
const hasPagination = Boolean(pagination.prev || pagination.next);
---

<footer class="sl-flex">
	{showAd && <AdSlot placement="inline" hideOnWide={Boolean(toc)} />}
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
		{showFeedback && <span class="feedback-links" data-pagefind-ignore>
			<a href={correction} target="_blank" rel="noopener noreferrer">{russian ? 'Сообщить о проблеме на странице (черновик GitHub)' : thai ? 'รายงานปัญหาในหน้านี้ (ฉบับร่าง GitHub)' : vietnamese ? 'Báo lỗi trên trang này (bản nháp GitHub)' : portuguese ? 'Relatar um problema nesta página (rascunho no GitHub)' : german ? 'Problem auf dieser Seite melden (GitHub-Entwurf)' : french ? 'Signaler un problème sur cette page (brouillon GitHub)' : korean ? '이 페이지의 문제 신고(GitHub 초안)' : japanese ? 'このページの問題を報告（GitHub の下書き）' : spanish ? 'Comunicar un problema de esta página (borrador en GitHub)' : english ? 'Report a page issue (GitHub draft)' : traditional ? '回報本頁問題（GitHub 草稿）' : '反馈本页问题（GitHub 草稿）'}</a>
			{' · '}<a href={updatesPath}>{russian ? 'Обновления материалов' : thai ? 'การอัปเดตเนื้อหา' : vietnamese ? 'Cập nhật nội dung' : portuguese ? 'Atualizações do conteúdo' : german ? 'Inhaltsaktualisierungen' : french ? 'Mises à jour du contenu' : korean ? '콘텐츠 업데이트' : japanese ? 'コンテンツの更新' : spanish ? 'Actualizaciones de contenido' : english ? 'Content updates' : traditional ? '內容更新' : '内容更新'}</a>
		</span>}
	</div>

	{
		hasPagination && (
			<>
				<div class="pagination-spacer" aria-hidden="true"></div>
				<div class="pagination-bar">
					<Pagination />
				</div>
			</>
		)
	}

	{
		config.credits && (
			<a
				class="kudos sl-flex"
				href="https://starlight.astro.build"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="starlight" /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}

	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}

	.kudos {
		align-items: center;
		gap: 0.5em;
		margin: 1.5rem auto;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		color: var(--sl-color-gray-3);
	}

	.kudos:hover {
		color: var(--sl-color-white);
	}

	.kudos :global(svg) {
		color: var(--sl-color-orange);
	}
</style>
