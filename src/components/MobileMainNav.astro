---
import config from 'virtual:starlight/user-config';
import context from 'virtual:starlight/project-context';
import { stripLocalePrefix } from '../utils/activeModule';
import { localizedUrl } from '../utils/localizedUrl';
import { getSiteLang, readerNavItems, pickLabel, uiLabels } from '../utils/siteNav';
import { standaloneHref, type StandalonePageId } from '../utils/standalonePages';

const locale = Astro.locals.starlightRoute.locale ?? 'root';
const normalizedLocale = locale === 'root' ? undefined : locale;
const lang = getSiteLang(locale, config.locales?.[locale]?.lang);
const visibleMainNavItems = readerNavItems(lang);
const isChinese = lang === 'zh-CN' || lang === 'zh-TW';
const resourcePaths = ['/ai-roadmap/', '/chatgpt-pricing/', '/pets/', '/theme/'];
const primaryItems = visibleMainNavItems.filter((item) => !isChinese || !resourcePaths.includes(item.href));
const resourceItems = visibleMainNavItems.filter((item) => isChinese && resourcePaths.includes(item.href));

function localizeHref(item: { href: string; global?: boolean; standalonePage?: StandalonePageId }) {
	if (item.global) return item.href;
	if (item.standalonePage) return standaloneHref(item.standalonePage, locale);
	return localizedUrl(new URL(item.href, Astro.url), locale, context.trailingSlash).pathname;
}

function isActive(prefix: string) {
	const path = stripLocalePrefix(Astro.url.pathname, normalizedLocale);
	if (isChinese && prefix.replace(/\/$/, '') === '/guide' && /^\/guide\/(learning-paths|reference)(\/|$)/.test(path)) return false;
	const base = prefix.replace(/\/$/, '');
	return path === base || path.startsWith(`${base}/`);
}
---

<nav class="mobile-main-nav" aria-label={pickLabel(uiLabels.mainNav, lang)}>
	{
		primaryItems.map((item) => (
			<a href={localizeHref(item)} aria-current={isActive(item.prefix) ? 'page' : undefined}>
				{pickLabel(item.label, lang)}
			</a>
		))
	}
	{resourceItems.length > 0 && <details>
		<summary>{pickLabel(uiLabels.resources, lang)}</summary>
		{resourceItems.map((item) => <a href={localizeHref(item)} aria-current={isActive(item.prefix) ? 'page' : undefined}>{pickLabel(item.label, lang)}</a>)}
	</details>}
</nav>

<style>
	.mobile-main-nav {
		display: grid;
		gap: 0.15rem;
		margin: 0 0 0.75rem;
		padding: 0 0 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline-shade);
	}

	.mobile-main-nav summary { padding: 0.55rem 0.65rem; cursor: pointer; }

	.mobile-main-nav a {
		display: block;
		padding: 0.55rem 0.65rem;
		border-radius: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}

	.mobile-main-nav a:hover,
	.mobile-main-nav a[aria-current='page'] {
		color: var(--sl-color-accent-high);
		background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
	}

	@media (min-width: 50rem) {
		.mobile-main-nav {
			display: none;
		}
	}
</style>
