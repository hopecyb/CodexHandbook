---
import { readFile } from 'node:fs/promises';
import rehypeStringify from 'rehype-stringify';
import remarkParse from 'remark-parse';
import remarkRehype from 'remark-rehype';
import { unified } from 'unified';
import { getMarkdownPaths, resolveDocsPath } from '../../utils/docsRoutes';

export const prerender = true;

function getTitle(markdown: string, path: string) {
	const heading = markdown.match(/^#\s+(.+)$/m)?.[1]?.trim();
	return heading || path.split('/').at(-1) || 'Docs';
}

async function renderMarkdown(markdown: string) {
	const file = await unified().use(remarkParse).use(remarkRehype).use(rehypeStringify).process(markdown);
	return String(file);
}

export async function getStaticPaths() {
	const paths = await getMarkdownPaths();

	return paths.map((path) => ({
		params: { path },
	}));
}

const path = Astro.params.path || '';
const filePath = resolveDocsPath(path);

if (!filePath) {
	return new Response('Not found', { status: 404 });
}

const markdown = await readFile(filePath, 'utf8');
const title = getTitle(markdown, path);
const html = await renderMarkdown(markdown);
const navItems = [
	{ href: '/guide/', label: 'Codex 指南' },
	{ href: '/prompts/', label: '提示词' },
	{ href: '/skills/', label: 'Skills' },
	{ href: '/cases/', label: '实战案例' },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | Codex 指南手册</title>
		<script is:inline>
			const storedTheme = localStorage.getItem('starlight-theme');
			const theme =
				storedTheme ||
				(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
			document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
		</script>
		<style>
			:root {
				--nav-height: 4rem;
				--bg: #111827;
				--bg-nav: #111827;
				--bg-sidebar: #151f32;
				--surface: #182338;
				--fg: #ffffff;
				--muted: #c2cada;
				--subtle: #8c96aa;
				--border: #2c3850;
				--accent: #94a8ff;
				--accent-strong: #bcc8ff;
				--code-bg: #0b1020;
				--code-fg: #e8eef8;
				color-scheme: dark;
			}

			:root[data-theme='light'] {
				--bg: #ffffff;
				--bg-nav: #ffffff;
				--bg-sidebar: #f7f9fc;
				--surface: #f8fafc;
				--fg: #1f2937;
				--muted: #4b5565;
				--subtle: #667085;
				--border: #e4e7ec;
				--accent: #2454ff;
				--accent-strong: #0b35d5;
				--code-bg: #101827;
				--code-fg: #e8eef8;
				color-scheme: light;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
					sans-serif;
				line-height: 1.75;
			}

			.site-header {
				position: fixed;
				z-index: 10;
				inset: 0 0 auto;
				height: var(--nav-height);
				border-bottom: 1px solid var(--border);
				background: color-mix(in srgb, var(--bg-nav) 92%, transparent);
				backdrop-filter: blur(16px);
			}

			.site-header__inner {
				display: grid;
				grid-template-columns: minmax(0, auto) 1fr auto;
				align-items: center;
				gap: 1.25rem;
				width: min(100% - 2rem, 88rem);
				height: 100%;
				margin: 0 auto;
			}

			.site-title {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				min-width: 0;
				color: var(--fg);
				font-size: 1.05rem;
				font-weight: 700;
				text-decoration: none;
				white-space: nowrap;
			}

			.site-title img {
				width: 2rem;
				height: 2rem;
				border-radius: 0.35rem;
			}

			.site-nav {
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}

			.site-nav a,
			.docs-chip {
				border-radius: 0.375rem;
				padding: 0.35rem 0.65rem;
				color: var(--muted);
				font-size: 0.9rem;
				font-weight: 550;
				text-decoration: none;
				white-space: nowrap;
			}

			.site-nav a:hover {
				background: color-mix(in srgb, var(--surface) 68%, transparent);
				color: var(--fg);
			}

			.docs-chip {
				border: 1px solid var(--border);
				background: color-mix(in srgb, var(--surface) 60%, transparent);
				color: var(--accent-strong);
			}

			.page-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				width: min(100% - 2rem, 88rem);
				margin: 0 auto;
				padding-top: var(--nav-height);
			}

			main {
				width: min(100%, 52rem);
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.breadcrumb {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				margin-bottom: 1.5rem;
				color: var(--subtle);
				font-size: 0.95rem;
				font-weight: 650;
				text-decoration: none;
			}

			.breadcrumb:hover {
				color: var(--accent);
			}

			article {
				font-size: 1.0625rem;
			}

			h1,
			h2,
			h3,
			h4 {
				line-height: 1.25;
				margin: 2rem 0 0.75rem;
			}

			h1 {
				margin-top: 0;
				font-size: clamp(2.4rem, 7vw, 4rem);
				letter-spacing: 0;
				color: var(--fg);
			}

			h2 {
				padding-top: 1rem;
				border-top: 1px solid var(--border);
				font-size: 1.85rem;
			}

			a {
				color: var(--accent);
			}

			blockquote {
				margin: 1.25rem 0;
				padding: 0.2rem 0 0.2rem 1rem;
				border-left: 4px solid var(--accent);
				color: var(--muted);
			}

			code {
				border-radius: 5px;
				background: color-mix(in srgb, var(--border), transparent 55%);
				padding: 0.1rem 0.28rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
					monospace;
				font-size: 0.92em;
			}

			pre {
				overflow-x: auto;
				border-radius: 8px;
				background: var(--code-bg);
				color: var(--code-fg);
				padding: 1rem;
				line-height: 1.55;
			}

			pre code {
				background: transparent;
				padding: 0;
				color: inherit;
			}

			table {
				display: block;
				overflow-x: auto;
				border-collapse: collapse;
			}

			th,
			td {
				border: 1px solid var(--border);
				padding: 0.55rem 0.7rem;
			}

			img {
				max-width: 100%;
			}

			@media (max-width: 54rem) {
				.site-header__inner {
					grid-template-columns: minmax(0, 1fr) auto;
				}

				.site-nav {
					display: none;
				}

				.docs-chip {
					font-size: 0.85rem;
				}

				main {
					padding-top: 2.75rem;
				}
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-title" href="/">
					<img src="/brand/logo.png" alt="" width="64" height="64" />
					<span>Codex 指南手册</span>
				</a>
				<nav class="site-nav" aria-label="主导航">
					{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<span class="docs-chip">项目文档</span>
			</div>
		</header>
		<div class="page-shell">
			<main>
				<a class="breadcrumb" href="/">← 返回手册首页</a>
				<article set:html={html} />
			</main>
		</div>
	</body>
</html>
